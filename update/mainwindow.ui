            <property name="styleSheet">
             <string notr="true"> QToolButton {
     border: 2px solid #FF407AFF;
     border-radius:2px;
	 background-color: #FF407AFF;
	 color:#FFFFFFFF;
	 font-size:14px;
	 font-weight:bold;
 }
QToolButton:hover
{
	border:2px solid  #FF407AFF;
	background-color: #FF407AFF;
}
 QToolButton:pressed {
     border: 2px solid #FF407AFF;
     border-radius: 2px;
	 background-color: #FF407AFF;
	 color:#FFFFFFFF;
 }
QToolButton:disabled {
     border: 2px solid #D9D9D9;
     border-radius: 2px;
	 background-color: #D9D9D9;
	 color:#FFFFFFFF;
 }

 QToolButton:flat {
     border: none; /* no border for a flat push button */
 }

 QToolButton:default {
     border-color: navy; /* make the default button prominent */
 }
</string>
            </property>
            <property name="text">
