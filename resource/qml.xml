import QtQuick 2.15
import QtQuick.Controls 2.15

ApplicationWindow {
    visible: true
    width: 640
    height: 480
    id: appWindow

    ListModel {
        id: listModel
        ListElement {
            name: "Item 1"
            checked: false
            background: "red"
        }
        ListElement {
            name: "Item 2"
            checked: true
            background: "red"
        }
        // 添加更多元素...
    }

    Timer {
        id: timer
        interval: 5000
        running: true
        repeat: true
        onTriggered: {
            for (var i = 0; i < listModel.count; i++) {
                var newColor = "rgb(" + Math.floor(Math.random() * 256) + "," +
                               Math.floor(Math.random() * 256) + "," +
                               Math.floor(Math.random() * 256) + ")";
                listModel.get(i).background = newColor;
            }
        }
    }

    ListView {
        id: listView
        anchors.fill: parent
        model: listModel
        delegate: Component {
            Rectangle {
                id: itemRect
                width: parent.width
                height: 50
                color: modelData.background
                Text {
                    id: itemText
                    text: modelData.name
                    anchors.centerIn: parent
                }
                CheckBox {
                    id: itemCheckbox
                    x: 10
                    y: 10
                    checked: modelData.checked // 与模型中的 checked 属性绑定
                    onCheckedChanged: {
                        // 更新模型中的 checked 值
                        listModel.get(index).checked = checked;
                        console.log("Checkbox status changed:", index, checked);
                    }
                }
                MouseArea {
                    anchors.fill: parent
                    onClicked: {
                        console.log("Clicked on item:", index, modelData.name);
                    }
                }
            }
        }
    }

    // 初始化数据
    Component.onCompleted: {
        for (var i = 0; i < 2; i++) {
            var item = {
                name: "Item " + (i + 3),
                checked: false,
                background: "lightblue"
            };
            listModel.append(item);
        }
    }
}
